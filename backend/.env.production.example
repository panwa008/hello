# =====================================================================
# Hello API — PRODUCTION  (copy to .env.production, fill in, NEVER commit)
# Secrets belong in your host's secret manager (Fly/Render/Railway secrets,
# Docker secrets, Vault…). The server refuses to boot (exit 78) when the
# required values are missing or weak.
# =====================================================================
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
DB_FILE=/data/hello.db
TZ_APP=Asia/Bangkok

# ---- Auth (REQUIRED) ----
# openssl rand -hex 32
JWT_SECRET=
# access token lifetime 60–3600 s (default 900) · refresh 1 h–90 d (default 30 d, rotated on every use)
ACCESS_TTL_SEC=900
REFRESH_TTL_SEC=2592000
# bcrypt cost 10–15 (production default 12)
BCRYPT_ROUNDS=12

# ---- HTTP (REQUIRED) ----
# exact https origins of the web app, comma separated ("*" is rejected)
CORS_ORIGIN=https://app.example.com
# public https base of this API (used for webhook + return URLs)
PUBLIC_API_URL=https://app.example.com
# true when behind nginx / a load balancer (X-Forwarded-For used for rate limits)
TRUST_PROXY=true
RATE_LIMIT=true
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_REFRESH_PER_MIN=30
RATE_LIMIT_PAY_PER_MIN=10
RATE_LIMIT_WEBHOOK_PER_MIN=120

# ---- Demo features (all OFF in production — leave them off) ----
DEMO_BOTS=false
DEMO_TOPUP=false
DEMO_SEED=false
# only if DEMO_SEED=true (≥12 chars, not hello123)
DEMO_PASSWORD=
ALLOW_SIM_STEPS=false
ALLOW_MANUAL_STEPS=false
ALLOW_MOCK_LOCATION=false
STARTER_POINTS=5000

# ---- TrueMoney (live) — values come from your TrueMoney merchant contract ----
# Without ALL six required values, charges return 501 (Thai + English) and nothing is credited.
TRUEMONEY_MODE=live
TRUEMONEY_API_BASE=
TRUEMONEY_MERCHANT_ID=
TRUEMONEY_API_KEY=
TRUEMONEY_API_SECRET=
TRUEMONEY_WEBHOOK_SECRET=
# Webhook URL to register with TrueMoney: ${PUBLIC_API_URL}/api/payments/truemoney/webhook
# Optional — align with the provider's spec:
TRUEMONEY_CHARGE_PATH=/v1/payments
TRUEMONEY_SIGNATURE_HEADER=x-truemoney-signature
TRUEMONEY_TIMESTAMP_HEADER=x-truemoney-timestamp
TRUEMONEY_TIMEOUT_MS=15000
# where TrueMoney sends the user back after paying
PAYMENT_RETURN_URL=https://app.example.com/#/wallet

# ---- PromptPay QR (optional) ----
# Personal PromptPay (phone 0812345678 / 13-digit ID) — static-amount QR, confirm via bank webhook
PROMPTPAY_ID=
# or a bank Bill Payment biller ID (15 digits, Ref1 = payment id) — recommended for business
PROMPTPAY_BILLER_ID=
PROMPTPAY_WEBHOOK_SECRET=
# Webhook URL: ${PUBLIC_API_URL}/api/payments/promptpay/webhook

GAME_DAILY_CAP=1000
