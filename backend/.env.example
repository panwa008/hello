# ---------- Hello API — development / sandbox ----------
# Copy to .env (never commit .env). `npm start` loads it automatically.
# For production use .env.production.example instead.
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DB_FILE=./data/hello.db
TZ_APP=Asia/Bangkok
# dev default secret is used when empty; production REQUIRES ≥32 random chars
JWT_SECRET=
# dev default "*"
CORS_ORIGIN=*
# All of these default to true in development and false in production
DEMO_BOTS=true
DEMO_TOPUP=true
DEMO_SEED=true
ALLOW_SIM_STEPS=true
ALLOW_MANUAL_STEPS=true
ALLOW_MOCK_LOCATION=true
# sandbox = no real money (instant credit + signed test webhooks); live = real TrueMoney (needs keys)
TRUEMONEY_MODE=sandbox
# sandbox webhook secret (default "sandbox-webhook-secret")
TRUEMONEY_WEBHOOK_SECRET=
# optional PromptPay QR (personal PromptPay = phone/ID; or a bank biller ID)
PROMPTPAY_ID=
PROMPTPAY_BILLER_ID=
GAME_DAILY_CAP=1000
