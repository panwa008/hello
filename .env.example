# Online mode: talk to the Hello API. "/" = same origin (Vite dev proxy or nginx forwards /api → API).
# Remove / leave empty to run fully offline on localStorage (demo mode).
VITE_API_URL=/
# Where the dev/preview proxy sends /api (not exposed to the browser)
API_PROXY_TARGET=http://localhost:3001
# HTTPS=1 to serve the dev server over https (real GPS on phones over LAN)
HTTPS=0
